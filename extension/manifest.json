{
  "manifest_version": 3,
  "name": "NOTA Labeling Organizer",
  "version": "1.6.57",
  "description": "Group frames by clip; use shortcuts for every bbox label, adjust any bbox edge, and apply annotations in bulk with Ctrl+B.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "NOTA Labeling Organizer",
    "default_popup": "popup.html"
  },
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://ntt.dev.nota.ai/*",
        "http://10.169.1.102:8765/*"
      ],
      "js": [
        "core.js",
        "styles.js",
        "sidebar.js",
        "bbox-warn.js",
        "bbox-filter.js",
        "bbox-tools.js",
        "seatbelt-eye.js",
        "eye-shortcuts.js",
        "face-shortcuts.js",
        "seatbelt-shortcuts.js",
        "bulk-dialogs.js",
        "content.js",
        "preload.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
